        {
          "id": "6ac5e6e8d97eae18cc40e34e",
          "title": "[Notice] Patch Notes | Oct. 6 (PDT) / Oct. 7 (CEST)",
          "region": "NA",
          "kind": "patch",
          "source": "na-update",
          "url": "https://aion2.plaync.com/en-us/board/update/view?articleId=6ac5e6e8d97eae18cc40e34e",
          "publishedAt": "2026-10-07T06:30:00.001Z",
          "sourceUpdatedAt": "2026-10-07T07:33:36.425Z",
          "contentHash": "6e00652e2be66aa3dd1c7539ea5e4ce14aedc2786b180d07fe4c27f29bc115b2",
          "bodyState": "ready",
          "reviewState": "reviewed",
          "summary": {
            "en": "Founder’s items can be claimed for other characters and servers. Wing morphing gets a weekly limit, leather drops increase, and map-pin and mission bugs are fixed.",
            "ko": "파운더스 아이템을 다른 캐릭터·서버에서도 받을 수 있게 했습니다. 날개 변환 주간 제한, 가죽 드롭 상향, 지도 징표·미션 오류 수정이 포함됐습니다."
          },
          "changes": [
            {
              "type": "system",
              "subject": {
                "en": "Founder’s items",
                "ko": "파운더스 아이템"
              },
              "description": {
                "en": "Eligible owners can claim missing items for free through the tier-specific Shop on other characters and servers.",
                "ko": "구매 등급별 전용 상점에서 미보유 아이템을 무료로 받아 다른 캐릭터·서버에서도 이용할 수 있습니다."
              }
            },
            {
              "type": "adjustment",
              "subject": {
                "en": "Wing morphing",
                "ko": "날개 물질 변환"
              },
              "description": {
                "en": "Sealed Wings → Enhance Stones: maximum 20 morphs per server per week.",
                "ko": "봉인 날개 → 강화석 변환은 서버별 주간 20회로 제한됩니다."
              }
            },
            {
              "type": "system",
              "subject": {
                "en": "Raw Leather",
                "ko": "생가죽 드롭"
              },
              "description": {
                "en": "Drop rates rise in Chaotic Lower Reshanta, Verteron and Altgard; no percentage is given.",
                "ko": "혼돈의 하층 에레슈란타·베르테론·알트가르드 드롭률을 높였습니다. 비율은 공개되지 않았습니다."
              }
            },
            {
              "type": "system",
              "subject": {
                "en": "Resurrection Spiritstone · Season 1",
                "ko": "부활의 정령석 · 시즌 1"
              },
              "description": {
                "en": "Shop price: 25,000 Kina; maximum 10 per server per week.",
                "ko": "상점 가격 25,000 키나, 서버별 주간 최대 10개입니다."
              }
            },
            {
              "type": "fix",
              "subject": {
                "en": "Map pins / Asmodian mission",
                "ko": "지도 징표 / 마족 주간 미션"
              },
              "description": {
                "en": "Pins correctly show a maximum of 30. The affected Asmodian weekly mission can complete normally.",
                "ko": "지도 징표 최대 30개가 정상 표시되고, 해당 마족 주간 미션 완료 오류가 수정됐습니다."
              }
            }
          ],
          "classScopeReviewed": true,
          "reviewedAt": "2026-10-08T08:21:39Z"
        }
      ]
    },
